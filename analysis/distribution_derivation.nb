Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    FractionBox[
     RowBox[{"2", " ", "\[Mu]"}], "s"]}]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"s", "+", 
     RowBox[{"S", " ", "x"}]}], ")"}], 
   RowBox[{
    RowBox[{"-", "1"}], "-", 
    FractionBox[
     RowBox[{"2", " ", "d"}], "S"], "-", 
    FractionBox[
     RowBox[{"2", " ", "\[Mu]"}], "s"]}]]}]], "Output",
 CellChangeTimes->{{3.983941555909061*^9, 3.983941563072029*^9}, 
