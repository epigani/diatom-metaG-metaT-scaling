Notebook[{
Cell[TextData[{
 "We consider the equation\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["dx", "dt"], "=", 
    RowBox[{"\[Mu]", " ", "-", 
     RowBox[{"d", " ", "x"}], "+", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          SubscriptBox["\[Sigma]", "d"], "2"], "x"}], "+", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["\[Sigma]", "e"], "2"], 
         SuperscriptBox["x", "2"]}]}], "]"}], "\[Eta]", " "}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5efc9ea6-315d-4770-be3d-e15309e98719"],
 "\nwhich is equivalent to the FP\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"dP", "(", 
      RowBox[{"x", ",", "t"}], ")"}], "dt"], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       FractionBox["d", "dx"], "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Mu]", " ", "-", 
          RowBox[{"d", " ", "x"}]}], ")"}], 
        RowBox[{"P", "(", 
         RowBox[{"x", ",", "t"}], ")"}]}], "]"}]}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{
       FractionBox[
        SuperscriptBox["d", "2"], 
        SuperscriptBox["dx", "2"]], "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[Sigma]", "d"], "2"], "x"}], "+", 
          RowBox[{
           SuperscriptBox[
            SubscriptBox["\[Sigma]", "e"], "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"P", "(", 
         RowBox[{"x", ",", "t"}], ")"}]}], "]"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "161ffe06-1fe8-4ebe-aea0-cce979d9ef33"],
 "\nWe define \nA(x)=\[Mu] -d x\nB(x)=",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[Sigma]", "d"], "2"], "x"}], "+", 
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[Sigma]", "e"], "2"], 
    SuperscriptBox["x", "2"]}]}]],ExpressionUUID->
  "4084802b-aa83-4ee5-8ca0-62a90c38d61d"],
 "\nso that the formal stationary solution is\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     FractionBox["\[CapitalNu]", 
      RowBox[{"B", "(", "x", ")"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{"2", " ", 
       RowBox[{"\[Integral]", 
        RowBox[{"dy", " ", 
         FractionBox[
          RowBox[{"A", "(", "y", ")"}], 
          RowBox[{"B", "(", "y", ")"}]]}]}]}], "]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aef7daf9-469e-4fac-90f6-92e94306a4ce"]
}], "Text",
 CellChangeTimes->{{3.983941042893928*^9, 
  3.9839414012442293`*^9}},ExpressionUUID->"3b06f4cd-8053-4595-8119-\
1630138482f9"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.983941156714332*^9, 
  3.983941158134688*^9}},ExpressionUUID->"b5756b9e-e59e-4760-b0f4-\
f2676d1e0b83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"x_", ",", "\[Mu]_", ",", "d_"}], "]"}], ":=", 
   RowBox[{"\[Mu]", "-", 
    RowBox[{"d", " ", "x"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"x_", ",", "s_", ",", "S_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"s", " ", "x"}], " ", "+", " ", 
    RowBox[{"S", " ", 
     SuperscriptBox["x", "2"]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9839414081751347`*^9, 3.9839414996149673`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"99e9ea5b-beef-4241-a5d8-f424cd6d91f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"A", "[", 
     RowBox[{"x", ",", "\[Mu]", ",", "d"}], "]"}], 
    RowBox[{"B", "[", 
     RowBox[{"x", ",", "s", ",", "S"}], "]"}]], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.983941503589253*^9, 3.983941527176359*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"861b1d71-b886-464d-8031-eb5c544ccbaa"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"\[Mu]", " ", 
    RowBox[{"Log", "[", "x", "]"}]}], "s"], "+", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "d"}], " ", "s"}], "-", 
      RowBox[{"S", " ", "\[Mu]"}]}], ")"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"s", "+", 
      RowBox[{"S", " ", "x"}]}], "]"}]}], 
   RowBox[{"s", " ", "S"}]]}]], "Output",
 CellChangeTimes->{3.983941528128861*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"9ab2d350-2ff1-4780-8752-54cb53fed14c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"B", "[", 
     RowBox[{"x", ",", "s", ",", "S"}], "]"}]], 
   RowBox[{"Exp", "[", 
    RowBox[{"2", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       FractionBox[
